# 研海寻踪 API Key 模板（.env.example）
#
# 用法：复制本文件为项目根目录的 `.env`，把各家 Key 填到等号后面。
# 规则（强制）：
#   1. `.env` 已被 .gitignore 忽略，绝不提交到 git；
#   2. Key 只通过私聊分发，绝不发群聊、不进源码、不进日志（代码已对报错打码）；
#   3. 变量名必须是 <供应商大写>_API_KEY，与 src/yanhai/providers.py 的
#      load_config_from_env 读取逻辑一一对应；
#   4. 没开通的供应商留空或整行删除即可，缺 Key 的模型组合会被实验显式记录
#      skipped，绝不允许静默回退规则模型。

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
ZHIPU_API_KEY=
QWEN_API_KEY=
