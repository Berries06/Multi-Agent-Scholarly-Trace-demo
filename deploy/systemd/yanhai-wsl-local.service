[Unit]
Description=Yanhai Trace local WSL study service
After=network.target

[Service]
Type=simple
User=snowsong
Group=snowsong
WorkingDirectory=/home/snowsong/apps/yanhai-trace/current
Environment=PYTHONPATH=/home/snowsong/apps/yanhai-trace/current/src
Environment=YANHAI_PROJECT_ROOT=/home/snowsong/apps/yanhai-trace/current
Environment=YANHAI_DATA_DIR=/home/snowsong/.local/share/yanhai-trace
Environment=YANHAI_COOKIE_SECURE=0
ExecStart=/usr/bin/python3 -m yanhai --host 127.0.0.1 --port 8877
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/snowsong/.local/share/yanhai-trace

[Install]
WantedBy=multi-user.target
