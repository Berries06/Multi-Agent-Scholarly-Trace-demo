[Unit]
Description=Yanhai Scholarly Trace Agent Demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yanhai-agent
Group=yanhai-agent
WorkingDirectory=/opt/yanhai-agent-demo/current
Environment=PYTHONPATH=/opt/yanhai-agent-demo/current/src
Environment=YANHAI_PROJECT_ROOT=/opt/yanhai-agent-demo/current
Environment=YANHAI_DATA_DIR=/var/lib/yanhai-agent-demo
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/yanhai-agent-demo.env
ExecStart=/usr/bin/python3 -m yanhai --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=yanhai-agent-demo
StateDirectoryMode=0750
ReadWritePaths=/var/lib/yanhai-agent-demo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
