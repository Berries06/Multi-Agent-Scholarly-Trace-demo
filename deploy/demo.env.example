# Local process defaults. Do not commit a real token.
YANHAI_HOST=127.0.0.1
YANHAI_PORT=8765
YANHAI_MAX_BODY_BYTES=1000000
YANHAI_MAX_WORKERS=4
YANHAI_MAX_QUEUED_TASKS=4
YANHAI_TASK_TIMEOUT_SECONDS=20
YANHAI_SOCKET_TIMEOUT_SECONDS=30
YANHAI_IDEMPOTENCY_TTL_SECONDS=300
YANHAI_ONLINE_TIMEOUT_SECONDS=5
YANHAI_ONLINE_RETRIES=1
YANHAI_ONLINE_BACKOFF_SECONDS=0.25
YANHAI_CIRCUIT_FAILURE_THRESHOLD=3
YANHAI_CIRCUIT_RESET_SECONDS=30

# Required when binding outside 127.0.0.1/::1/localhost:
# YANHAI_API_TOKEN=replace-with-a-long-random-secret
# For an explicitly loopback-published container only:
# YANHAI_ALLOW_REMOTE_WITHOUT_TOKEN=true
