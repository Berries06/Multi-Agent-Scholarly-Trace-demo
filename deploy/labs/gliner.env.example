# Copy to /etc/yanhai-gliner-lab.env with mode 0600.
# Never commit real passwords or Hugging Face credentials.
GLINER_LAB_PASSWORD=replace-with-a-long-random-password
GLINER_MODEL_ID=urchade/gliner_small-v2.1
GLINER_MODEL_DIR=/var/lib/yanhai-gliner/models/gliner_small-v2.1
GLINER_AUDIT_DIR=/var/lib/yanhai-gliner/audit
CUDA_VISIBLE_DEVICES=0
HF_HOME=/var/lib/yanhai-gliner/huggingface
MKL_NUM_THREADS=8
OMP_NUM_THREADS=8
OPENBLAS_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false
